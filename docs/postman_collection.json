{
  "info": {
    "name": "Products API",
    "description": "Colección para la prueba Backend Laravel. Ejecute Login antes de las rutas protegidas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "base_url", "value": "http://127.0.0.1:8000"},
    {"key": "token", "value": ""},
    {"key": "product_id", "value": "1"},
    {"key": "currency_id", "value": "1"}
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "auth": {"type": "noauth"},
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": "{{base_url}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data?.access_token) pm.collectionVariables.set('token', body.data.access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List products",
          "request": {"method": "GET", "header": [{"key": "Accept", "value": "application/json"}], "url": "{{base_url}}/api/products"}
        },
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Laptop\",\n  \"description\": \"Equipo de trabajo\",\n  \"price\": \"1000.00\",\n  \"currency_id\": 1,\n  \"tax_cost\": \"160.00\",\n  \"manufacturing_cost\": \"600.00\",\n  \"manufacuring_date_create\": \"2026-01-15\",\n  \"manufacuring_date_expire\": \"2028-01-15\"\n}"},
            "url": "{{base_url}}/api/products"
          }
        },
        {
          "name": "Show product",
          "request": {"method": "GET", "header": [{"key": "Accept", "value": "application/json"}], "url": "{{base_url}}/api/products/{{product_id}}"}
        },
        {
          "name": "Update product",
          "request": {
            "method": "PUT",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Laptop Pro\",\n  \"description\": \"Equipo actualizado\",\n  \"price\": \"1200.00\",\n  \"currency_id\": 1,\n  \"tax_cost\": \"192.00\",\n  \"manufacturing_cost\": \"700.00\",\n  \"manufacuring_date_create\": \"2026-01-15\",\n  \"manufacuring_date_expire\": \"2028-01-15\"\n}"},
            "url": "{{base_url}}/api/products/{{product_id}}"
          }
        },
        {
          "name": "Delete product",
          "request": {"method": "DELETE", "header": [{"key": "Accept", "value": "application/json"}], "url": "{{base_url}}/api/products/{{product_id}}"}
        },
        {
          "name": "List product prices",
          "request": {"method": "GET", "header": [{"key": "Accept", "value": "application/json"}], "url": "{{base_url}}/api/products/{{product_id}}/prices"}
        },
        {
          "name": "Create product price",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"currency_id\": 2,\n  \"price\": \"920.00\"\n}"},
            "url": "{{base_url}}/api/products/{{product_id}}/prices"
          }
        }
      ]
    },
    {
      "name": "Currencies",
      "item": [
        {
          "name": "List currencies",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{base_url}}/api/currency"
          }
        },
        {
          "name": "Create currency",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Libra esterlina\",\n  \"symbol\": \"GBP\",\n  \"exchange_rate\": \"0.760000\",\n  \"exchange_rate_date\": \"2026-10-27\"\n}"},
            "url": "{{base_url}}/api/currency"
          }
        },
        {
          "name": "Show currency",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{base_url}}/api/currency/{{currency_id}}"
          }
        }
      ]
    }
  ]
}
